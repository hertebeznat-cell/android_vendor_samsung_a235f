//
// AOSP Bluetooth Audio HAL 2.0 (HIDL) for the stock Android 11 vendor. SEZB1
// only ships Samsung's ISehBluetoothAudioProvidersFactory, which the AOSP
// Bluetooth stack does not use; without IBluetoothAudioProvidersFactory A2DP
// stays disabled. The stock 32-bit audio service loads the -impl library when
// present, and HAL libraries are looked up in /odm before /vendor.
//
// Plain AOSP code built for Android 11 (VNDK 30) from the Motorola edge (racer)
// vendor, motorola/racer_retail/racer:11/RPD31.Q4U-39-26-4/3c874:user/release-keys
// (public dump erfanoabdi/motorola_racer_dump, vendor/lib). They only link VNDK 30
// and LLNDK libraries, so ELF checks against this tree's libraries do not apply.

cc_prebuilt_library_shared {
    name: "a235f_android.hardware.bluetooth.audio@2.0-impl",
    stem: "android.hardware.bluetooth.audio@2.0-impl",
    device_specific: true,
    relative_install_path: "hw",
    compile_multilib: "32",
    arch: {
        arm: {
            srcs: ["lib/hw/android.hardware.bluetooth.audio@2.0-impl.so"],
        },
    },
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "a235f_audio.bluetooth.default",
    stem: "audio.bluetooth.default",
    device_specific: true,
    relative_install_path: "hw",
    compile_multilib: "32",
    arch: {
        arm: {
            srcs: ["lib/hw/audio.bluetooth.default.so"],
        },
    },
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "a235f_libbluetooth_audio_session",
    stem: "libbluetooth_audio_session",
    device_specific: true,
    compile_multilib: "32",
    arch: {
        arm: {
            srcs: ["lib/libbluetooth_audio_session.so"],
        },
    },
    check_elf_files: false,
    strip: {
        none: true,
    },
}
