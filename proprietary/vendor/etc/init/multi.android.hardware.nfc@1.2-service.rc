# The NXP service and its HIDL interfaces are declared in
# nxp.android.hardware.nfc@1.2-service.rc. Keep one service definition so init
# does not discard that declaration after parsing this file first.

service nfc_hal_service /vendor/bin/hw/sec.android.hardware.nfc@1.2-service
    disabled
    class hal
    user nfc
    group nfc net_bt_admin

on property:ro.boot.product.hardware.sku=sn110t
    start vendor.nfc_hal_service

on property:ro.boot.product.hardware.sku=s3fwrn5
    start nfc_hal_service

on property:ro.boot.nfc.feature.chipname=NXP_SN100U
    start vendor.nfc_hal_service

on property:ro.boot.nfc.feature.chipname=SLSI
    start nfc_hal_service
