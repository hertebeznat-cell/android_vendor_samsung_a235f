//
// Stock SEZB1 /odm/etc/selinux. Since odm is built (BOARD_USES_ODMIMAGE),
// system/sepolicy installs its own precompiled_sepolicy there. That policy is
// compiled without the stock API 30 vendor policy, and init prefers it because
// its hashes match the system: the stock vendor property types are missing and
// init aborts with "Failed to initialize property area". The stock files carry
// One UI's hashes, so init compiles the policy at boot from the stock vendor
// CIL, as it did with the untouched odm image.

prebuilt_etc {
    name: "a235f_odm_precompiled_sepolicy",
    src: "precompiled_sepolicy",
    filename: "precompiled_sepolicy",
    relative_install_path: "selinux",
    device_specific: true,
    overrides: ["precompiled_sepolicy"],
}

prebuilt_etc {
    name: "a235f_odm_precompiled_sepolicy.plat_sepolicy_and_mapping.sha256",
    src: "precompiled_sepolicy.plat_sepolicy_and_mapping.sha256",
    filename: "precompiled_sepolicy.plat_sepolicy_and_mapping.sha256",
    relative_install_path: "selinux",
    device_specific: true,
    overrides: ["precompiled_sepolicy.plat_sepolicy_and_mapping.sha256"],
}

prebuilt_etc {
    name: "a235f_odm_precompiled_sepolicy.system_ext_sepolicy_and_mapping.sha256",
    src: "precompiled_sepolicy.system_ext_sepolicy_and_mapping.sha256",
    filename: "precompiled_sepolicy.system_ext_sepolicy_and_mapping.sha256",
    relative_install_path: "selinux",
    device_specific: true,
    overrides: ["precompiled_sepolicy.system_ext_sepolicy_and_mapping.sha256"],
}

prebuilt_etc {
    name: "a235f_odm_precompiled_sepolicy.product_sepolicy_and_mapping.sha256",
    src: "precompiled_sepolicy.product_sepolicy_and_mapping.sha256",
    filename: "precompiled_sepolicy.product_sepolicy_and_mapping.sha256",
    relative_install_path: "selinux",
    device_specific: true,
    overrides: ["precompiled_sepolicy.product_sepolicy_and_mapping.sha256"],
}
